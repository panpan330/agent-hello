<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.panpan.aibusinessservice.mapper.OrderMapper">
    <resultMap id="OrderResultMap" type="com.panpan.aibusinessservice.entity.Order">
        <id column="order_id" property="orderId"/>
        <result column="user_id" property="ownerUserId"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="order_status" property="orderStatus"/>
        <result column="payment_status" property="paymentStatus"/>
        <result column="logistics_message" property="logisticsMessage"/>
        <result column="latest_event" property="latestEvent"/>
        <result column="can_create_ticket" property="canCreateTicket"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <sql id="OrderColumns">
        order_id,
        user_id,
        tenant_id,
        order_status,
        payment_status,
        logistics_message,
        latest_event,
        can_create_ticket,
        created_at,
        updated_at
    </sql>

    <select id="selectByTenantIdAndOrderId" resultMap="OrderResultMap">
        SELECT
          <include refid="OrderColumns"/>
        FROM orders
        WHERE tenant_id = #{tenantId}
          AND order_id = #{orderId}
    </select>

    <select id="selectByTenantIdAndUserId" resultMap="OrderResultMap">
        SELECT
          <include refid="OrderColumns"/>
        FROM orders
        WHERE tenant_id = #{tenantId}
          AND user_id = #{userId}
        ORDER BY updated_at DESC, order_id ASC
    </select>

    <select id="selectAllByTenantId" resultMap="OrderResultMap">
        SELECT
          <include refid="OrderColumns"/>
        FROM orders
        WHERE tenant_id = #{tenantId}
        ORDER BY updated_at DESC, order_id ASC
    </select>
</mapper>
